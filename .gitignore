# ============================================
# ip-counter — .gitignore
# ============================================

# Reports (generated)
report_*.txt
*.report

# Logs
*.log
!tests/fixtures/*.log

# Temp files
*.tmp
*.swp
*~

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.sublime-*

# Build artifacts
build/
dist/
*.tar.gz

# Local config (with secrets)
config/local.conf
